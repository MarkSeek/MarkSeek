{
  "name": "MarkSeek",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarkSeek/MarkSeek.git"
  },
  "homepage": "https://github.com/MarkSeek/MarkSeek#readme",
  "bugs": {
    "url": "https://github.com/MarkSeek/MarkSeek/issues"
  },
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && npm run build:plugins",
    "build:plugins": "cross-env PLUGIN_NAME=excalidraw vite build --config vite.plugins.config.ts && cross-env PLUGIN_NAME=custom-block vite build --config vite.plugins.config.ts && cross-env PLUGIN_NAME=theme-sample vite build --config vite.plugins.config.ts && cross-env PLUGIN_NAME=mermaid vite build --config vite.plugins.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test",
    "preview": "vite preview",
    "start": "node app/app.js",
    "start:electron": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@milkdown/core": "^7.21.2",
    "@milkdown/crepe": "^7.21.2",
    "@milkdown/kit": "^7.21.2",
    "@milkdown/plugin-slash": "^7.21.2",
    "@milkdown/preset-commonmark": "^7.21.2",
    "@milkdown/react": "^7.21.2",
    "@milkdown/theme-nord": "^7.21.2",
    "@types/markdown-it": "^14.1.2",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.3.0",
    "mermaid": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-deb": "^7.6.0",
    "@electron-forge/maker-dmg": "^7.6.0",
    "@electron-forge/maker-rpm": "^7.6.0",
    "@electron-forge/maker-squirrel": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "jsdom": "^29.1.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
